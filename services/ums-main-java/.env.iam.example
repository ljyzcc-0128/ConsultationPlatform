# ============================================================
# IAM 接入配置示例（API 调用模式）
# 复制此文件为 .env.iam 并填入公司 IAM 系统的实际值
# 启动时 export 环境变量，或通过 --spring.config.additional-location 加载
# ============================================================

# --- 开启 IAM ---
UMS_IAM_ENABLED=true

# --- IAM 认证 API 地址 ---
# 后端 POST 此地址，body: {"username":"xxx","password":"xxx"}
# 期望响应 200: {"externalId":"EMP001","username":"zhangsan","displayName":"张三","email":"zhangsan@company.com","roles":["USER"],"status":"ACTIVE"}
# 期望响应 401: {"error":"用户名或密码错误"}
UMS_IAM_AUTH_API_URL=https://iam.company.com/api/auth/verify

# --- 调用 IAM API 的认证方式 ---
# API_KEY: 通过 X-API-Key 请求头传 api-key
# BEARER:  通过 Authorization: Bearer 请求头传 bearer-token
# NONE:    无需额外认证（内网直连）
UMS_IAM_AUTH_MODE=API_KEY

# --- 认证凭据（根据 auth-mode 填写） ---
UMS_IAM_API_KEY=your-iam-api-key-here
# UMS_IAM_BEARER_TOKEN=your-bearer-token-here

# --- 认证超时秒数 ---
UMS_IAM_TIMEOUT_SECONDS=10

# --- 首次 IAM 登录是否自动创建 cp_user ---
# true: 自动创建（推荐，减少运维开户工作）
# false: 需管理员预先在后台创建用户（externalId 与 IAM 返回一致）
UMS_IAM_AUTO_PROVISION=true

# --- 新建 IAM 用户的默认角色（逗号分隔） ---
UMS_IAM_DEFAULT_ROLES=USER

# --- 可选：将默认认证方式改为 IAM ---
# 前端通过 VITE_AUTH_PROVIDER=IAM 控制登录页显示密码输入
# 后端无需设置此项（前端 provider 直接传 "IAM"）
